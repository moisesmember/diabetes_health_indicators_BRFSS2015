# Copie para `.env` e ajuste. O Docker Compose lê este arquivo automaticamente.
# Todos os valores têm padrão no compose.yaml; o .env só é necessário para mudá-los.

# Banco de metadados do MLflow (troque a senha fora do ambiente local).
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# Portas expostas no host.
MLFLOW_PORT=5000
API_PORT=8000

# Tag das imagens trainer/api e commit gravado nos runs do MLflow.
# Sugestão: IMAGE_TAG=$(git rev-parse --short HEAD)
IMAGE_TAG=latest
GIT_COMMIT=unknown
